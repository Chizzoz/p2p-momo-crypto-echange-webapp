APP_NAME="e-Mpiya P2P"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local (DDEV): http://empiya-p2p-webapp.ddev.site
# Production (Dokploy): https://p2p.oneziko.com
APP_URL=http://empiya-p2p-webapp.ddev.site

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DDEV defaults (host "db" from inside the web container)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production behind HTTPS (Dokploy / Traefik):
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.oneziko.com

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sanctum / cookies — production:
# SANCTUM_STATEFUL_DOMAINS=p2p.oneziko.com

# Dokploy: set true on first boot to seed currencies/countries/MNOs/USDT, then false
RUN_DB_SEEDERS=false

# Sepolia Empiya contracts (public addresses only — never put private keys in VITE_*).
# In Docker/Dokploy these are BUILD ARGS (baked into the JS bundle), not runtime-only env.
# Copy from p2p-momo-crypto-exchange .env after deploy.
VITE_CHAIN_ID=11155111
VITE_ALCHEMY_API_KEY=
VITE_EMPIYA_P2P_ADDRESS=
VITE_EMPIYA_PAYMENTS_ADDRESS=
VITE_USDT_ADDRESS=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06
VITE_USDT_DECIMALS=6

# PawaPay (sandbox first — set API key before live MoMo deposit/payout tests)
PAWAPAY_API_KEY=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io/v2
PAWAPAY_MODE=sandbox
PAWAPAY_KEY_ID=1
PAWAPAY_PRIVATE_KEY=

# Empiya operator (server-side only — never put in VITE_*)
EMPIYA_RPC_URL=
EMPIYA_CHAIN_ID=11155111
EMPIYA_OPERATOR_PRIVATE_KEY=
EMPIYA_P2P_ADDRESS=
EMPIYA_PAYMENTS_ADDRESS=
EMPIYA_USDT_ADDRESS=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06
EMPIYA_USDT_DECIMALS=6
