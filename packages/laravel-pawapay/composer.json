{
    "name": "chizzoz/laravel-pawapay",
    "description": "A Laravel package for PawaPay v2 integration with mobile money providers in Zambia.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chizzoz",
            "email": "developer@chizzoz.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Chizzoz\\PawaPay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chizzoz\\PawaPay\\PawaPayServiceProvider"
            ],
            "aliases": {
                "PawaPay": "Chizzoz\\PawaPay\\Facades\\PawaPay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0"
}
